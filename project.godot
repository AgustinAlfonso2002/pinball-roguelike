; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FICHINLIKE"
config/description="FICHINLIKE: un roguelike de pinball en un arcade de barrio."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.086, 0.051, 0.149, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Tuning="*res://scripts/tuning.gd"
GameInput="*res://scripts/game_input.gd"
Sfx="*res://scripts/sfx.gd"
Items="*res://scripts/items/item_registry.gd"
Run="*res://scripts/run.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

fonts/dynamic_fonts/use_oversampling=false

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16
2d/default_gravity=0.0
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
